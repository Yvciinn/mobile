<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ===== AJOUT : les 6 permissions de l'atelier ===== -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- ===== AJOUT (bonus) : permission personnalisée pour sécuriser le broadcast ===== -->
    <permission
        android:name="com.example.tp1.permission.RECEIVE_PREFERENCES"
        android:protectionLevel="signature" />

    <!-- ===== AJOUT : visibilité du service de reconnaissance vocale (Android 11+) ===== -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Tp1">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".MainActivity2"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".MainActivity3"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".MovieActivity4"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".MovieActivity5"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".MovieActivity6"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".MovieActivity7"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- ===== AJOUT : les 3 services ===== -->
        <service
            android:name=".services.SimulationService"
            android:exported="false" />

        <service
            android:name=".services.EnregistrementService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <service
            android:name=".services.AnalyseService"
            android:exported="false" />

    </application>

</manifest>